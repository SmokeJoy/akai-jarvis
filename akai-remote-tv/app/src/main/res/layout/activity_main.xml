<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1015"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AKAI Custom Remote"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telecomando Locale per iPhone e Android"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controllo hardware autonomo (funzionante anche con PC spento)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <!-- Status Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#181A22"
            android:padding="22dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stato Server: Inizializzazione..."
                android:textColor="#10B981"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_server_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apri su Safari / Chrome: http://192.168.1.8:8088"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tv_uinput_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver Hardware Linux: /dev/uinput attivo"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tv_paired_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispositivi associati: 0"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protezione: PIN a 6 cifre, rate limiting anti-brute force, rete locale LAN"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_show_pin"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:text="Associa Nuovo Telefono (Mostra QR &amp; PIN)"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_revoke_all"
            android:layout_width="320dp"
            android:layout_height="48dp"
            android:text="Revoca Tutti i Dispositivi Associati"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_minimize"
            android:layout_width="320dp"
            android:layout_height="48dp"
            android:text="Riduci a Icona e Torna alla Home"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
