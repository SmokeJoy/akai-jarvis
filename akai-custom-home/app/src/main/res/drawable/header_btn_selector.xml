<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="3dp" android:color="@color/focus_gold" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0284C7" />
            <stroke android:width="2dp" android:color="@color/focus_cyan" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/topbar_pill_bg" />
            <stroke android:width="1dp" android:color="@color/topbar_pill_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
