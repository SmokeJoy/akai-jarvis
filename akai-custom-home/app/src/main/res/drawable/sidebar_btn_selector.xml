<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="3.5dp" android:color="@color/focus_gold" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#0284C7" />
            <stroke android:width="2.5dp" android:color="@color/focus_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sidebar_btn_bg" />
            <stroke android:width="1.2dp" android:color="@color/sidebar_btn_stroke" />
        </shape>
    </item>
</selector>
