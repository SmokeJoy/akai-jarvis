<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#FF5722"
                android:endColor="#E50914"
                android:type="linear" />
            <stroke android:width="3.5dp" android:color="@color/focus_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#FF3D00"
                android:endColor="#D50000"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="#FF8A65" />
        </shape>
    </item>
</selector>
