<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cinematic_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Top Header Bar (Responsive 1080p layout, guaranteed zero clipping) -->
    <LinearLayout
        android:id="@+id/layout_header_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="6dp">

        <!-- Brand Wordmark matching Concept Art -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_akai"
                android:textColor="@color/akai_red"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginEnd="10dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#33FFFFFF"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_brand_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_custom_tv"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="170dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status & Action Pills (Sentence Case, Compact Responsive Width) -->
        <Button
            android:id="@+id/btn_home_wifi"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="165dp"
            android:text="@string/btn_wifi"
            android:textColor="@color/status_green_live"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_home_remote"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:singleLine="true"
            android:text="@string/btn_remote"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_home_theme"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:singleLine="true"
            android:text="@string/btn_theme"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_home_settings"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:singleLine="true"
            android:text="@string/btn_settings"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#26FFFFFF"
            android:layout_marginEnd="10dp" />

        <!-- Digital Clock (Explicit HH:mm on BOTH 12h/24h formats to prevent clipping) -->
        <TextClock
            android:id="@+id/home_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:singleLine="true"
            android:minWidth="46dp"
            android:gravity="end|center_vertical"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Main Workspace: Left Sidebar + 4-Row Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Left Vertical Navigation Rail (Sidebar) -->
        <LinearLayout
            android:id="@+id/sidebar_navigation"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="14dp"
            android:paddingEnd="4dp">

            <!-- 1. Home -->
            <LinearLayout
                android:id="@+id/sidebar_nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/btn_home_wifi"
                android:nextFocusDown="@id/sidebar_nav_movies"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:background="@drawable/sidebar_home_active_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/sidebar_home"
                    android:textColor="@color/text_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 2. Film & Serie -->
            <LinearLayout
                android:id="@+id/sidebar_nav_movies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/sidebar_nav_home"
                android:nextFocusDown="@id/sidebar_nav_apps"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="🎬"
                    android:textSize="16sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/sidebar_movies"
                    android:textColor="@color/text_sidebar"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 3. App -->
            <LinearLayout
                android:id="@+id/sidebar_nav_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/sidebar_nav_movies"
                android:nextFocusDown="@id/sidebar_nav_livetv"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="㗊"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/sidebar_apps"
                    android:textColor="@color/text_sidebar"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 4. Live TV -->
            <LinearLayout
                android:id="@+id/sidebar_nav_livetv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/sidebar_nav_apps"
                android:nextFocusDown="@id/sidebar_nav_settings"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="📺"
                    android:textSize="16sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/sidebar_livetv"
                    android:textColor="@color/text_sidebar"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 5. Impostazioni -->
            <LinearLayout
                android:id="@+id/sidebar_nav_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@id/sidebar_nav_livetv">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:text="⚙️"
                    android:textSize="16sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/sidebar_settings"
                    android:textColor="@color/text_sidebar"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Hairline Vertical Divider between Sidebar & Content (Concept Art Detail) -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1AFFFFFF"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Main Scrollable Body (Clip horizontal scroll cleanly inside right pane, allow vertical glow via padding) -->
        <ScrollView
            android:id="@+id/scroll_main_body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:paddingStart="12dp">

            <LinearLayout
                android:id="@+id/layout_sections_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Section 1: Ingressi Hardware -->
                <LinearLayout
                    android:id="@+id/section_inputs_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_inputs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_inputs"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_inputs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="true"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:id="@+id/ll_inputs_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <Button
                                android:id="@+id/btn_src_dtv"
                                android:layout_width="154dp"
                                android:layout_height="48dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:textAllCaps="false"
                                android:nextFocusLeft="@id/sidebar_nav_home"
                                android:nextFocusUp="@id/btn_home_wifi"
                                android:text="@string/src_dtv"
                                android:textColor="@color/text_white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="10dp" />

                            <Button
                                android:id="@+id/btn_src_hdmi1"
                                android:layout_width="164dp"
                                android:layout_height="48dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:textAllCaps="false"
                                android:nextFocusUp="@id/btn_home_wifi"
                                android:text="@string/src_hdmi1"
                                android:textColor="@color/text_white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="10dp" />

                            <Button
                                android:id="@+id/btn_src_hdmi2"
                                android:layout_width="148dp"
                                android:layout_height="48dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:textAllCaps="false"
                                android:nextFocusUp="@id/btn_home_remote"
                                android:text="@string/src_hdmi2"
                                android:textColor="@color/text_white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="10dp" />

                            <Button
                                android:id="@+id/btn_src_hdmi3"
                                android:layout_width="148dp"
                                android:layout_height="48dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:textAllCaps="false"
                                android:nextFocusUp="@id/btn_home_theme"
                                android:text="@string/src_hdmi3"
                                android:textColor="@color/text_white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="10dp" />

                            <Button
                                android:id="@+id/btn_src_all"
                                android:layout_width="156dp"
                                android:layout_height="48dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:textAllCaps="false"
                                android:nextFocusUp="@id/btn_home_settings"
                                android:text="@string/src_all"
                                android:textColor="@color/text_white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Section 2: App Preferite -->
                <LinearLayout
                    android:id="@+id/section_favorites_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/layout_fav_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_favorites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_favorites"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_fav_help"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btn_fav_reorder"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:textAllCaps="false"
                            android:text="@string/btn_edit_favs"
                            android:textColor="@color/text_gray"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/header_btn_selector"
                            android:focusable="true"
                            android:visibility="gone" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_favs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="true"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="7dp">

                        <LinearLayout
                            android:id="@+id/ll_fav_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Section 3: Streaming & Cinema (Wider 16:9 TV Showcase Cards) -->
                <LinearLayout
                    android:id="@+id/section_streaming_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/layout_streaming_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_streaming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_streaming"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_streaming_help"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_streaming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="true"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="7dp">

                        <LinearLayout
                            android:id="@+id/ll_streaming_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Section 4: Tutte le Applicazioni -->
                <LinearLayout
                    android:id="@+id/section_all_apps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:id="@+id/layout_all_apps_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_all_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_all_apps"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_all_apps_help"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_all_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="true"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="7dp">

                        <LinearLayout
                            android:id="@+id/ll_all_apps_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
