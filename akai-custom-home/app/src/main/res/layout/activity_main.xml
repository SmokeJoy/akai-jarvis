<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Logo Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_akai"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/badge_akai"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_custom_tv"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Wi-Fi Status Button -->
        <Button
            android:id="@+id/btn_home_wifi"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="📶 Wi-Fi"
            android:textColor="@color/focus_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <!-- Remote iPhone Pairing Button -->
        <Button
            android:id="@+id/btn_home_remote"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/btn_remote"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <!-- Personalizzazione Tema / Colori / Sezioni -->
        <Button
            android:id="@+id/btn_home_theme"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/btn_theme"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <!-- System Settings Button -->
        <Button
            android:id="@+id/btn_home_settings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/btn_settings"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="14dp" />

        <!-- Digital Clock -->
        <TextClock
            android:id="@+id/home_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Section 1: Ingressi Hardware Container -->
    <LinearLayout
        android:id="@+id/section_inputs_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_title_inputs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_inputs"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_src_dtv"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:text="@string/src_dtv"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/source_chip_selector"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_src_hdmi1"
                android:layout_width="180dp"
                android:layout_height="44dp"
                android:text="@string/src_hdmi1"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/source_chip_selector"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_src_hdmi2"
                android:layout_width="130dp"
                android:layout_height="44dp"
                android:text="@string/src_hdmi2"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/source_chip_selector"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_src_hdmi3"
                android:layout_width="130dp"
                android:layout_height="44dp"
                android:text="@string/src_hdmi3"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/source_chip_selector"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_src_all"
                android:layout_width="145dp"
                android:layout_height="44dp"
                android:text="@string/src_all"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/source_chip_selector"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Section 2: App Preferite Container -->
    <LinearLayout
        android:id="@+id/section_favorites_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/layout_fav_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_title_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_favorites"
                android:textColor="@color/focus_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  (Tieni premuto OK per riordinare o rimuovere)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_fav_reorder"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_edit_favs"
                android:textColor="@color/focus_gold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/header_btn_selector"
                android:focusable="true" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/scroll_favs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_fav_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Section 3: Tutte le Applicazioni Container -->
    <LinearLayout
        android:id="@+id/section_all_apps_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_title_all_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_all_apps"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  (Tieni premuto OK su un\'app per aggiungerla ai Preferiti)"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Apps Grid -->
        <GridView
            android:id="@+id/gv_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="6"
            android:verticalSpacing="10dp"
            android:horizontalSpacing="10dp"
            android:stretchMode="columnWidth"
            android:gravity="center"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>

</LinearLayout>
