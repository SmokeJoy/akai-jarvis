<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cinematic_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_header_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginBottom="6dp">

        <!-- Logo Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_akai"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/badge_akai"
                android:layout_marginEnd="12dp" />

            <View
                android:layout_width="1.5dp"
                android:layout_height="20dp"
                android:background="#334155"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_brand_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_custom_tv"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Pills -->
        <Button
            android:id="@+id/btn_home_wifi"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_wifi"
            android:textColor="@color/status_green_live"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_home_remote"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_remote"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_home_theme"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_theme"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_home_settings"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/btn_settings"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/header_btn_selector"
            android:focusable="true"
            android:layout_marginEnd="14dp" />

        <!-- Digital Clock -->
        <TextClock
            android:id="@+id/home_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Main Workspace: Left Sidebar + Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Left Vertical Navigation Rail (Sidebar) -->
        <LinearLayout
            android:id="@+id/sidebar_navigation"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp">

            <!-- 1. Home -->
            <LinearLayout
                android:id="@+id/sidebar_nav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:background="@drawable/sidebar_home_active_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_home"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 2. Film & Serie -->
            <LinearLayout
                android:id="@+id/sidebar_nav_movies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="🎬"
                    android:textSize="18sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_movies"
                    android:textColor="@color/text_sidebar"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 3. App -->
            <LinearLayout
                android:id="@+id/sidebar_nav_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="㗊"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_apps"
                    android:textColor="@color/text_sidebar"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 4. Live TV -->
            <LinearLayout
                android:id="@+id/sidebar_nav_livetv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="📺"
                    android:textSize="18sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_livetv"
                    android:textColor="@color/text_sidebar"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 5. Impostazioni -->
            <LinearLayout
                android:id="@+id/sidebar_nav_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="⚙️"
                    android:textSize="18sp"
                    android:background="@drawable/sidebar_btn_selector" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sidebar_settings"
                    android:textColor="@color/text_sidebar"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Main Scrollable Body (4 Rows of Content) -->
        <ScrollView
            android:id="@+id/scroll_main_body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="12dp">

            <LinearLayout
                android:id="@+id/layout_sections_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Section 1: Ingressi Hardware -->
                <LinearLayout
                    android:id="@+id/section_inputs_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_inputs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_inputs"
                            android:textColor="@color/text_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_inputs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:id="@+id/ll_inputs_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <Button
                                android:id="@+id/btn_src_dtv"
                                android:layout_width="165dp"
                                android:layout_height="52dp"
                                android:text="@string/src_dtv"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="12dp" />

                            <Button
                                android:id="@+id/btn_src_hdmi1"
                                android:layout_width="195dp"
                                android:layout_height="52dp"
                                android:text="@string/src_hdmi1"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="12dp" />

                            <Button
                                android:id="@+id/btn_src_hdmi2"
                                android:layout_width="150dp"
                                android:layout_height="52dp"
                                android:text="@string/src_hdmi2"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="12dp" />

                            <Button
                                android:id="@+id/btn_src_hdmi3"
                                android:layout_width="150dp"
                                android:layout_height="52dp"
                                android:text="@string/src_hdmi3"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true"
                                android:layout_marginEnd="12dp" />

                            <Button
                                android:id="@+id/btn_src_all"
                                android:layout_width="165dp"
                                android:layout_height="52dp"
                                android:text="@string/src_all"
                                android:textColor="@color/text_white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:background="@drawable/source_chip_selector"
                                android:focusable="true" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Section 2: App Preferite -->
                <LinearLayout
                    android:id="@+id/section_favorites_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/layout_fav_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_favorites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_favorites"
                            android:textColor="@color/text_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_fav_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btn_fav_reorder"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="@string/btn_edit_favs"
                            android:textColor="@color/text_gray"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/header_btn_selector"
                            android:focusable="true"
                            android:visibility="gone" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_favs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:id="@+id/ll_fav_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Section 3: Streaming & Cinema -->
                <LinearLayout
                    android:id="@+id/section_streaming_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:id="@+id/layout_streaming_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_streaming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_streaming"
                            android:textColor="@color/text_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_streaming_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_streaming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:id="@+id/ll_streaming_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Section 4: Tutte le Applicazioni -->
                <LinearLayout
                    android:id="@+id/section_all_apps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/layout_all_apps_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="|"
                            android:textColor="@color/section_accent_amber"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_title_all_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/section_all_apps"
                            android:textColor="@color/text_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_all_apps_help"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scroll_all_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:id="@+id/ll_all_apps_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
